\name{HiddenTrunc-package}
\alias{HiddenTrunc}
\alias{HiddenTrunc-package}
\title{Hidden Truncation Probability Distributions and Inference}
\description{Probability functions, simulation, likelihood inference and Bayesian computation for hidden-truncation models.}
\details{The initial implementation contains upper hidden-truncated Pareto IV and two-sided hidden-truncated Arnold-Strauss exponential models, plus generic hidden-truncation utilities.}
